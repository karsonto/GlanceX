<Window x:Class="DesktopTranslator.Views.TranslationOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        MinWidth="250"
        MinHeight="120"
        Width="420"
        Height="300"
        Left="100"
        Top="100">

    <Border Background="White" CornerRadius="10" Margin="6"
            BorderBrush="#E0E0E0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.15" Color="Black" Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#FAFAFA" CornerRadius="10,10,0,0"
                    Padding="14,10" MouseLeftButtonDown="TitleBar_MouseDown"
                    BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                <DockPanel>
                    <!-- Close button -->
                    <Button DockPanel.Dock="Right"
                            Click="Close_Click"
                            Style="{StaticResource IconButton}"
                            ToolTip="关闭" Width="28" Height="28">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>

                    <!-- Copy button -->
                    <Button x:Name="BtnCopy" DockPanel.Dock="Right"
                            Click="Copy_Click"
                            Style="{StaticResource IconButton}"
                            ToolTip="复制翻译结果" Width="28" Height="28" Margin="0,0,2,0">
                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                    </Button>

                    <!-- Pin button -->
                    <Button x:Name="BtnPin" DockPanel.Dock="Right"
                            Click="Pin_Click"
                            Style="{StaticResource IconButton}"
                            ToolTip="固定窗口" Width="28" Height="28" Margin="0,0,2,0">
                        <TextBlock x:Name="PinIcon" Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                    </Button>

                    <!-- Title -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="翻译结果"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Translation Content -->
            <Grid Grid.Row="1">
                <!-- Loading indicator -->
                <StackPanel x:Name="LoadingPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <ProgressBar IsIndeterminate="True"
                                 Width="200" Height="3"
                                 Foreground="{StaticResource PrimaryBrush}"
                                 Background="#F0F0F0"
                                 BorderThickness="0" />
                    <TextBlock Text="正在翻译..."
                               FontFamily="{StaticResource AppFont}"
                               FontSize="13"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0" />
                </StackPanel>

                <!-- Placeholder text -->
                <TextBlock x:Name="PlaceholderText"
                           Text="选择屏幕区域后开始翻译..."
                           FontFamily="{StaticResource AppFont}"
                           FontSize="14"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Visible" />

                <!-- Translation result -->
                <ScrollViewer x:Name="ResultScroller"
                              VerticalScrollBarVisibility="Auto"
                              Padding="16,12"
                              Visibility="Collapsed">
                    <TextBlock x:Name="TranslationText"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap"
                               LineHeight="24" />
                </ScrollViewer>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="2" Background="#FAFAFA" CornerRadius="0,0,10,10"
                    Padding="14,6" BorderBrush="#F0F0F0" BorderThickness="0,1,0,0">
                <DockPanel>
                    <TextBlock x:Name="StatusText"
                               Text="就绪"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="CharCount"
                               DockPanel.Dock="Right"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
