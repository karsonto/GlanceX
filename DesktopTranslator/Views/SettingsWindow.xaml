<Window x:Class="DesktopTranslator.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="520" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFont}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                       FontSize="28" Foreground="{StaticResource PrimaryBrush}" />
            <TextBlock Text="设置" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0" />
            <TextBlock Text="配置 API 连接和翻译参数"
                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Settings Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- API Configuration Card -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="API 配置" Style="{StaticResource SectionHeader}" />

                        <!-- Base URL -->
                        <TextBlock Text="API 地址 (Base URL)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="TxtBaseUrl"
                                 Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,14" />

                        <!-- API Key -->
                        <TextBlock Text="API 密钥 (API Key)" Style="{StaticResource FieldLabel}" />
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="PwdApiKey"
                                         Style="{StaticResource ModernPasswordBox}"
                                         PasswordChanged="PwdApiKey_PasswordChanged" />
                            <TextBox x:Name="TxtApiKeyVisible"
                                     Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     Visibility="Collapsed" />
                            <Button Grid.Column="1" Margin="6,0,0,0"
                                    Click="ToggleApiKeyVisibility_Click"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="显示/隐藏密钥" Width="36" Height="36">
                                <TextBlock x:Name="EyeIcon" Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                            </Button>
                        </Grid>

                        <!-- Model -->
                        <TextBlock Text="模型名称" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,14" />

                        <!-- Test Connection -->
                        <Button Content="{Binding IsTesting, Converter={x:Null}, FallbackValue='测试连接'}"
                                x:Name="BtnTest"
                                Style="{StaticResource SecondaryButton}"
                                Click="TestConnection_Click"
                                HorizontalAlignment="Left"
                                Margin="0,4,0,0" />

                        <TextBlock x:Name="TxtTestResult"
                                   Text="{Binding TestResult}"
                                   FontSize="12"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Translation Settings Card -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="翻译参数" Style="{StaticResource SectionHeader}" />

                        <!-- System Prompt -->
                        <TextBlock Text="系统提示词 (System Prompt)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Height="80"
                                 VerticalContentAlignment="Top"
                                 Margin="0,0,0,14" />

                        <!-- Temperature -->
                        <TextBlock Style="{StaticResource FieldLabel}">
                            <Run Text="Temperature: " />
                            <Run Text="{Binding Temperature, StringFormat=F1}" />
                        </TextBlock>
                        <Slider Value="{Binding Temperature}"
                                Minimum="0" Maximum="1"
                                TickFrequency="0.1"
                                IsSnapToTickEnabled="True"
                                Margin="0,0,0,4" />
                    </StackPanel>
                </Border>

                <!-- Hotkeys Card -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="快捷键" Style="{StaticResource SectionHeader}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="选择翻译区域" FontSize="13"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1" Background="#F3F3F3" CornerRadius="4" Padding="10,5">
                                <TextBlock Text="Ctrl + Alt + S" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>

                            <TextBlock Grid.Row="1" Text="开始/停止翻译" FontSize="13"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" Margin="0,10,0,0" />
                            <Border Grid.Row="1" Grid.Column="1" Background="#F3F3F3" CornerRadius="4" Padding="10,5" Margin="0,10,0,0">
                                <TextBlock Text="Ctrl + Alt + T" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" Style="{StaticResource SecondaryButton}"
                    Click="Cancel_Click" Margin="0,0,10,0" />
            <Button Content="保存" Style="{StaticResource PrimaryButton}"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
